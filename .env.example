# =============================================================================
# Clockify Filler — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to git — it's already in .gitignore
# =============================================================================

# GitHub Personal Access Token (required for private/org repos)
# Create at: https://github.com/settings/tokens
# Scope needed: repo (full control of private repositories)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username
GITHUB_USERNAME=your-github-username

# Comma-separated GitHub orgs/users whose repos should be scanned.
# Your own account is always included.
GITHUB_ORGS=superist-group,Lisnic-com

# Optional: extra git author names/emails to attribute to you (case-insensitive).
# Useful for commits made from hosts whose git identity isn't linked to your account.
GITHUB_AUTHOR_ALIASES=you@example.com

# Clockify API Key (required)
# Find at: https://app.clockify.me/user/preferences → API section at bottom
CLOCKIFY_API_KEY=your-clockify-api-key-here

# OpenAI API Key (optional — enables GPT-powered descriptions)
# Create at: https://platform.openai.com/api-keys
# If not set, the script falls back to simple keyword-based descriptions
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
